# Este archivo es solo una plantilla. No guardar contraseñas reales en Git.
DJANGO_ENV=development
DJANGO_SECRET_KEY=cambiar-en-cada-entorno
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# Para el arranque local se usa SQLite. Al configurar MySQL, cambiar el engine
# y completar las credenciales sin subir el archivo .env real al repositorio.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=sisetma
DB_USER=sisetma
DB_PASSWORD=cambiar
DB_HOST=localhost
DB_PORT=3306
