# Este archivo es solo una plantilla. No guardar contraseñas reales en Git.
DJANGO_ENV=development
DJANGO_SECRET_KEY=cambiar-en-cada-entorno
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# Configuración local por defecto: SQLite.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Para usar MySQL, reemplazar los valores anteriores por los siguientes.
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=sisetma
# DB_USER=sisetma_app
# DB_PASSWORD=definir-solo-en-el-archivo-local
# DB_HOST=localhost
# DB_PORT=3306


# Almacenamiento privado S3 / MinIO. No guardar credenciales reales en Git.
AWS_ACCESS_KEY_ID=definir-solo-en-el-archivo-local
AWS_SECRET_ACCESS_KEY=definir-solo-en-el-archivo-local
AWS_STORAGE_BUCKET_NAME=sisetma-estudios
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_PRESIGNED_EXPIRATION=3600
S3_MULTIPART_PART_SIZE=10485760
S3_MAX_UPLOAD_SIZE=2147483648
S3_HASH_CHUNK_SIZE=8388608

