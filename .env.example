# Este archivo es solo una plantilla. No guardar contraseñas reales en Git.
DJANGO_ENV=development
DJANGO_SECRET_KEY=cambiar-en-cada-entorno
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# Configuración local por defecto: SQLite.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Para usar MySQL, reemplazar los valores anteriores por los siguientes.
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=sisetma
# DB_USER=sisetma_app
# DB_PASSWORD=definir-solo-en-el-archivo-local
# DB_HOST=localhost
# DB_PORT=3306
